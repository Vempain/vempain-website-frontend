{
  "extends" : "./tsconfig.app.json",
  "compilerOptions" : {
    "types" : [
      "jest",
      "node",
      "vite/client"
    ],
    "allowJs" : true,
    "verbatimModuleSyntax" : false,
    "allowImportingTsExtensions" : true,
    "module" : "ESNext",
    "moduleResolution" : "bundler",
    "resolveJsonModule" : true
  },
  "include" : [
    "src/setupTests.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "exclude" : []
}
